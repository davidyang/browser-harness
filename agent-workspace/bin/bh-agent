#!/usr/bin/env python3
"""Run a named Browser Harness agent against a persistent Brave instance."""

from __future__ import annotations

import json
import os
from pathlib import Path
import subprocess
import sys


WORKSPACE = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(WORKSPACE))

from browser_instance import BrowserInstance, InstanceError  # noqa: E402


USAGE = "usage: bh-agent <agent-name> [--instance <instance-name>] [--stop|--restart-instance [--dry-run]|browser-harness arguments]"


def run_harness(arguments, environment, **kwargs):
    return subprocess.run(["browser-harness", *arguments], env=environment, **kwargs)


def stop_agent(environment) -> int:
    doctor = run_harness(
        ["doctor", "--json", "--require-existing-daemon"],
        environment,
        text=True,
        capture_output=True,
    )
    if doctor.returncode == 0:
        run_harness(
            [],
            environment,
            input="cleanup_agent_tabs()\n",
            text=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    return run_harness(["--reload"], environment).returncode


def launch_unlocked(environment) -> None:
    subprocess.run(
        [str(WORKSPACE / "bin" / "launch-brave")],
        env=environment,
        check=True,
        stdout=subprocess.DEVNULL,
    )


def launch(instance: BrowserInstance, environment) -> None:
    with instance.mutation_lock():
        launch_unlocked(environment)


def parse(argv):
    if not argv:
        raise ValueError(USAGE)
    agent_name = argv.pop(0)
    instance_name = os.environ.get("BH_BRAVE_INSTANCE", "shared")
    if argv[:1] == ["--instance"]:
        if len(argv) < 2:
            raise ValueError(USAGE)
        instance_name = argv[1]
        del argv[:2]
    return agent_name, instance_name, argv


def main(argv=None) -> int:
    try:
        agent_name, instance_name, arguments = parse(list(sys.argv[1:] if argv is None else argv))
        instance = BrowserInstance.create(agent_name, instance_name)
        environment = instance.environment()
        try:
            environment["BU_CDP_WS"] = instance.endpoint()
        except InstanceError:
            environment.pop("BU_CDP_WS", None)

        if arguments == ["--stop"]:
            return stop_agent(environment)
        if arguments in (["--restart-instance"], ["--restart-instance", "--dry-run"]):
            dry_run = arguments[-1] == "--dry-run"
            if not dry_run:
                stop_agent(environment)
            result = instance.restart(
                dry_run=dry_run,
                launch=lambda: launch_unlocked(environment),
            )
            print(json.dumps(result, sort_keys=True))
            return 0

        launch(instance, environment)
        environment["BU_CDP_WS"] = instance.endpoint()
        run_harness(
            [],
            environment,
            input="ensure_sentinel()\n",
            text=True,
            check=True,
            stdout=subprocess.DEVNULL,
        )
        os.execvpe("browser-harness", ["browser-harness", *arguments], environment)
    except (ValueError, InstanceError, subprocess.CalledProcessError) as error:
        print(f"bh-agent: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
