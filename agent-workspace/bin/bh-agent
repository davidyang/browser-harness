#!/bin/zsh
set -euo pipefail

if (( $# < 1 )); then
  print -u2 'usage: bh-agent <short-stable-agent-name> [--stop|browser-harness arguments]'
  exit 2
fi

agent_name="$1"
shift

if [[ ! "$agent_name" =~ '^[A-Za-z0-9_-]{1,24}$' ]]; then
  print -u2 'agent name must contain 1–24 letters, digits, underscores, or hyphens'
  exit 2
fi

workspace_dir="${0:A:h:h}"
profile="${BH_BRAVE_PROFILE:-$HOME/Library/Application Support/BraveSoftware/Brave-Browser-Automation}"

export BU_NAME="agent-${agent_name}"
export BH_AGENT_WORKSPACE="$workspace_dir"
export BH_RUNTIME_DIR="/private/tmp/bh-${agent_name}"
export BH_TMP_DIR="/private/tmp/bh-${agent_name}-tmp"

load_brave_endpoint() {
  local active_port active_path
  active_port="$(sed -n '1p' "$profile/DevToolsActivePort" 2>/dev/null || true)"
  active_path="$(sed -n '2p' "$profile/DevToolsActivePort" 2>/dev/null || true)"
  if [[ "$active_port" =~ '^[0-9]+$' && "$active_path" == /devtools/browser/* ]]; then
    unset BU_CDP_URL
    export BU_CDP_WS="ws://127.0.0.1:${active_port}${active_path}"
    return 0
  fi
  return 1
}

if (( $# == 1 )) && [[ "$1" == "--stop" ]]; then
  load_brave_endpoint || true
  if browser-harness doctor --json --require-existing-daemon >/dev/null 2>&1; then
    print 'cleanup_agent_tabs()' | browser-harness >/dev/null 2>&1 || true
  fi
  exec browser-harness --reload
fi

"$workspace_dir/bin/launch-brave" >/dev/null
load_brave_endpoint || {
  print -u2 'Brave started but its DevToolsActivePort is invalid'
  exit 1
}

# Ensure the anchor exists even if somebody closed it while Brave stayed open.
print 'ensure_sentinel()' | browser-harness >/dev/null
exec browser-harness "$@"
